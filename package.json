{
	"name": "portailetu",
	"private": true,
	"version": "0.9.0",
	"license": "SEE LICENSE IN LICENSE",
	"type": "module",
	"scripts": {
		"dev": "rm -r node_modules/.vite-temp; vite dev",
		"build": "rm -rf node_modules/.vite-temp && vite build",
		"preview": "rm -r node_modules/.vite-temp; vite preview",
		"prepare": "husky && bun run paraglide:compile",
		"paraglide:compile": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide --strategy cookie preferredLanguage baseLocale",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"check": "bun run paraglide:compile && svelte-kit sync && svelte-check --tsgo --tsconfig ./tsconfig.json",
		"check:watch": "bun run paraglide:compile && svelte-kit sync && svelte-check --tsgo --tsconfig ./tsconfig.json --watch",
		"tsc-check": "tsc --noEmit",
		"test": "vitest run",
		"test:coverage": "vitest run --coverage",
		"test:e2e": "playwright test"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@fontsource-variable/fredoka": "^5.3.0",
		"@fontsource-variable/nunito": "^5.3.0",
		"@fontsource/fira-mono": "^5.3.0",
		"@humanspeak/svelte-markdown": "^1.8.7",
		"@inlang/paraglide-js": "^2.24.1",
		"@playwright/test": "^1.62.1",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.3",
		"@testing-library/dom": "^10.4.1",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/svelte": "^5.4.2",
		"@types/bun": "^1.4.0",
		"@typescript-eslint/eslint-plugin": "^8.68.0",
		"@typescript-eslint/parser": "^8.68.0",
		"@typescript/native": "npm:typescript@^7.0.2",
		"@vitest/coverage-v8": "^4.1.11",
		"eslint": "^10.9.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^17.11.0",
		"husky": "^9.1.7",
		"jsdom": "^30.0.1",
		"lint-staged": "^17.3.0",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.56.10",
		"svelte-adapter-bun": "^1.0.1",
		"svelte-check": "^4.7.6",
		"svelte-eslint-parser": "^1.8.1",
		"tailwindcss": "^4.3.3",
		"typescript": "~6.0.3",
		"vite": "^8.2.2",
		"vitest": "^4.1.11"
	},
	"overrides": {
		"brace-expansion": "^5.0.9",
		"cookie": "^0.7.0",
		"nanoid": "^3.3.18",
		"postcss": "^8.5.26"
	},
	"lint-staged": {
		"*.{js,ts,svelte}": [
			"prettier --write",
			"eslint --fix"
		],
		"*.{json,md,yml,yaml,html,css}": [
			"prettier --write"
		]
	}
}
