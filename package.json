{
	"name": "portailetu",
	"version": "1.0.0",
	"private": true,
	"license": "SEE LICENSE IN LICENSE",
	"type": "module",
	"scripts": {
		"dev": "rm -r node_modules/.vite-temp; vite dev",
		"build": "rm -rf node_modules/.vite-temp && vite build",
		"preview": "rm -r node_modules/.vite-temp; vite preview",
		"prepare": "husky && bun run paraglide:compile",
		"paraglide:compile": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide --strategy cookie preferredLanguage baseLocale",
		"lint": "oxlint -c .oxlintrc.json .",
		"lint:fix": "oxlint -c .oxlintrc.json --fix .",
		"lint:svelte": "sh ./scripts/run-oxvelte.sh lint src",
		"lint:svelte:fix": "sh ./scripts/run-oxvelte.sh lint --fix src",
		"format": "oxfmt -c ./oxfmt.json --write .",
		"format:check": "oxfmt -c ./oxfmt.json --check .",
		"check": "bun run paraglide:compile && svelte-kit sync && svelte-check --tsgo --tsconfig ./tsconfig.json",
		"check:watch": "bun run paraglide:compile && svelte-kit sync && svelte-check --tsgo --tsconfig ./tsconfig.json --watch",
		"tsc-check": "tsc --noEmit",
		"test": "vitest run",
		"test:coverage": "vitest run --coverage"
	},
	"devDependencies": {
		"@fontsource-variable/fredoka": "^5.3.0",
		"@fontsource-variable/nunito": "^5.3.0",
		"@fontsource/fira-mono": "^5.3.0",
		"@humanspeak/svelte-markdown": "^1.9.0",
		"@inlang/paraglide-js": "^2.25.0",
		"@lucide/svelte": "^1.38.0",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.3",
		"@testing-library/dom": "^10.4.1",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/svelte": "^5.4.2",
		"@types/bun": "^1.4.0",
		"@typescript/native": "npm:typescript@^7.0.2",
		"@vitest/coverage-v8": "^4.1.11",
		"husky": "^9.1.7",
		"jsdom": "^30.0.1",
		"oxfmt": "^0.65.0",
		"oxlint": "^1.80.0",
		"svelte": "^5.57.0",
		"svelte-adapter-bun": "^1.0.1",
		"svelte-check": "^4.7.6",
		"tailwindcss": "^4.3.3",
		"typescript": "~6.0.3",
		"vite": "^8.2.2",
		"vitest": "^4.1.11"
	},
	"overrides": {
		"brace-expansion": "^5.0.9",
		"cookie": "^0.7.0",
		"nanoid": "^3.3.18",
		"postcss": "^8.5.26"
	},
	"engines": {
		"bun": "1.3.8"
	},
	"packageManager": "bun@1.3.8"
}
